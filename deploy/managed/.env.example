# Copy to .env, then replace the empty token with the output of:
# openssl rand -hex 32
# An empty token intentionally prevents the managed profile from starting.
WOOLWIRE_RUNNER_TOKEN=
WOOLWIRE_HOST_PORT=127.0.0.1:7070
# Optional absolute host directory. Omit to use a named volume.
# WOOLWIRE_MODELS=/absolute/path/to/models

# Rootless Podman only. The container runs as UID 1000, which rootless Podman
# maps to a high subordinate UID on the host -- so a bind-mounted models
# directory or a state volume owned by your user is unreadable inside the
# container ("unable to open database file", or an empty model list). Mapping
# UID 1000 back to your own user fixes both:
# WOOLWIRE_USERNS_MODE=keep-id:uid=1000,gid=1000
# Leave it unset for Docker and for rootful Podman, which do not need it.
